# Cloudflare Workers AI Configuration Template for Matric Mastery AI (v3.8.0)
# Free-First AI Architecture — No Credit Card Required on Workers Free Plan

name = "matric-mastery-ai-worker"
main = "index.ts"
compatibility_date = "2025-11-01"
workers_dev = true

# Native Cloudflare Workers AI Binding
# Grants access to 10,000 free Neurons per day without API keys or credit cards
[ai]
binding = "AI"

# Environment Variables — Configurable Model Selection
[vars]
# Active text model (~563 realistic queries/day on 10,000 free daily Neurons)
TEXT_MODEL = "@cf/meta/llama-3.1-8b-instruct-fast"

# Vision model remains separated & disabled until parent/guardian accepts Meta's Llama 3.2 license
VISION_MODEL = "@cf/meta/llama-3.2-11b-vision-instruct"
ENABLE_VISION_MODEL = "false"

# Strict Production CORS Origins (comma-separated, no trailing slashes)
ALLOWED_ORIGINS = "https://matric-mastery-pk.vercel.app,http://localhost:3000,http://127.0.0.1:3000"

[placement]
mode = "smart"
